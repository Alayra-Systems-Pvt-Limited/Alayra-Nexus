# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build output ───────────────────────────────────────────────────────────────
dist/
build/

# ── Environment & Secrets ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor ─────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# ── Testing & Coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Prisma ─────────────────────────────────────────────────────────────────────
# Keep migrations committed — they are deployment history
# Ignore only local dev shadow DB artifacts
prisma/*.db
prisma/*.db-journal

# ── Internal planning docs (not for public repo) ────────────────────────────────
# Roadmaps/upgrade plans live here for internal use only. User-facing docs
# (Phase 10 "Docs tab" content, API reference, quickstart) must NOT live under
# an ignored path — put those under a committed one so they aren't accidentally
# hidden from the OSS repo.
#
# `docs/*` rather than `docs/`: git will not descend into an ignored *directory*,
# so a negation for a child would never be evaluated.
docs/*
!docs/architecture/
!docs/assets/
# The built static demo. Committed on purpose: GitHub Pages publishes it straight from the default
# branch, so the artefact has to be in the tree — and keeping it here means a fork gets the demo
# without running a build. Rebuilt by `npm run build:demo` in web/.
!docs/demo/
# Dated output of `npm run verify:providers`, measured against live provider APIs. Committed
# because it is the EVIDENCE for the provider claims in src/data/providers.ts and in anything we
# say publicly about how many providers are verified. A claim whose proof is gitignored is a claim
# nobody can check — and this file is written by a script, never by hand, so it cannot drift into
# marketing. It holds no credentials: account-scoped URLs are recorded with their placeholder.
!docs/provider-verification/
# The README's reference chapters, split out of it because npm renders only the first 64 KB of a
# readme and ours had grown past it. These are linked FROM the README, so leaving them ignored
# would put five dead links on the project's front page — the exact accident the note at the top of
# this block warns about, which had already happened once to the verification evidence above.
# Listed by name rather than as `!docs/*.md` so a future internal plan dropped in here stays
# internal by default; a public page is a deliberate addition.
!docs/api.md
!docs/backup.md
!docs/routing.md
!docs/security.md
!docs/standalone.md

# ── Misc ───────────────────────────────────────────────────────────────────────
.claude/
*.tgz

# ── E2E (Playwright artefacts; e2e/node_modules is caught by the global rule) ──
e2e/test-results/
e2e/playwright-report/
e2e/.state/

# Local scratch: session tokens and boot logs from dev runs; npm cache redirected off C:
.tmp/
.npmcache/

# Standalone mode (Phase S2): the local SQLite database and anything else the gateway
# writes beside it. Never a thing to commit — it is a running deployment, not source.
.nexus/
.flake-hunt/

# Benchmark profiling artifacts. A .cpuprofile at 100us resolution is tens of MB and is
# regenerated by `npm run bench:profile`; the CONCLUSIONS belong in docs, not the raw samples.
.bench/
*.cpuprofile
