{
  "name": "@alayrasystems/nexus",
  "version": "1.5.2",
  "description": "AI key pool proxy — route Claude, Gemini, GPT through one OpenAI-compatible endpoint",
  "license": "Apache-2.0",
  "main": "dist/server.js",
  "bin": {
    "alayra-nexus": "bin/alayra-nexus.js"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "//": "Load-bearing now that the package is scoped: a scoped package defaults to restricted, so without this the first publish would either fail or quietly ship a package nobody can install.",
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "prisma",
    "scripts/npm/postinstall.js",
    "web/dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "ai-gateway",
    "llm-proxy",
    "openai-compatible",
    "anthropic",
    "litellm-alternative",
    "load-balancing",
    "rate-limiting",
    "cost-tracking",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alayra-Systems-Pvt-Limited/Alayra-Nexus.git"
  },
  "homepage": "https://github.com/Alayra-Systems-Pvt-Limited/Alayra-Nexus#readme",
  "bugs": {
    "url": "https://github.com/Alayra-Systems-Pvt-Limited/Alayra-Nexus/issues"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:sqlite-schema": "tsx scripts/db/sqliteSchema.ts",
    "db:generate": "npx prisma generate && npx prisma generate --schema prisma/schema.sqlite.prisma",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:standalone": "tsx scripts/smoke/standalone.ts",
    "seed": "tsx scripts/seed/seed.ts",
    "demo:fixtures": "tsx scripts/demo/buildFixtures.ts",
    "bench:sqlite-journal": "tsx scripts/bench/sqliteJournal.ts",
    "test:hunt": "tsx scripts/test/huntFlakes.ts",
    "backup:fixture": "tsx scripts/backup/makeFixture.ts",
    "smoke:npx": "tsx scripts/smoke/npx.ts",
    "postinstall": "node scripts/npm/postinstall.js",
    "prepack": "node scripts/npm/prepack.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^5.10.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "ioredis": "^5.3.2",
    "jose": "^5.10.0",
    "js-tiktoken": "^1.0.21",
    "prisma": "^5.10.2",
    "prom-client": "^15.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": ">=5.0.8"
  }
}
